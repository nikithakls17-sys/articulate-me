# local = Ollama Gemma + faster-whisper + browser TTS (nothing leaves the machine)
# hosted = DigitalOcean Gemma + ElevenLabs STT/TTS
MODE=local

# LLM: ollama | digitalocean (defaults from MODE)
LLM_PROVIDER=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma3:1b
# json (Gemma 4, hosted) or stepwise (tiny local models); defaults from MODE
GRADER=
DO_INFERENCE_BASE_URL=https://inference.do-ai.run/v1
DO_MODEL_ACCESS_KEY=
DO_MODEL=
PROMPT_VERSION=v1

# Speech: whisper | elevenlabs (defaults from MODE)
STT_PROVIDER=
WHISPER_MODEL=base.en
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Data: leave empty to use the on-disk JSON store (data/local_store)
MONGODB_URI=
MONGODB_DB=italk

# Private /admin/feedback page (leave empty to disable it)
ADMIN_PASSWORD=

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev

# Credit protection
MAX_RECORDING_SEC=90
MAX_ATTEMPTS_PER_DAY=30
MAX_CONCURRENT_SESSIONS=4
